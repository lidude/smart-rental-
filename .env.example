PORT=4000

# PostgreSQL connection (used for Render and other cloud hosts)
# Example: postgresql://user:password@host:5432/database_name
DATABASE_URL=

# Fallback PostgreSQL env vars (used if DATABASE_URL not set)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=verified_rental

# Security
JWT_SECRET=change_this_secret
